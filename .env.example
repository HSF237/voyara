# ─────────────────────────────────────────────────────────────────────────────
# Voyara environment variables
# Copy this file to `.env.local` and fill in what you have.
# Milestone 1 runs with every value empty.
# ─────────────────────────────────────────────────────────────────────────────

# ── Browser (public by design — shipped in the bundle) ──────────────────────
# Firebase web config. These identify the project; security comes from
# Firestore rules, not from hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# MapTiler key. The browser loads map tiles directly, so this cannot be
# hidden — restrict it to your domains in the MapTiler dashboard.
VITE_MAPTILER_KEY=

# Public URL of the deployed app (share links, QR codes, Open Graph).
VITE_APP_URL=http://localhost:5173

# ── Server only (Vercel functions in /api — never shipped to the browser) ───
# Which AI provider /api/ai uses: "gemini" (default) or "anthropic".
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Places (OpenTripMap) and routing (OpenRouteService), proxied by /api.
OPENTRIPMAP_API_KEY=
ORS_API_KEY=

# Sent with fallback geocoding requests to Nominatim, e.g.
# "Voyara/0.1 (you@example.com)". Their usage policy requires it.
NOMINATIM_USER_AGENT=

# Optional enrichments. Leave empty to skip them.
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Local only (scripts/seed-curated.ts) ────────────────────────────────────
# Firebase service-account JSON on one line. Never commit or deploy this.
FIREBASE_SERVICE_ACCOUNT=
